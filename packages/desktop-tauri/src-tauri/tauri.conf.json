{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conductor",
  "mainBinaryName": "conductor",
  "version": "0.0.0",
  "identifier": "dev.conductor.desktop",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/conductor-server"],
    "resources": {
      "../../ui/dist/": "ui-dist"
    }
  }
}
